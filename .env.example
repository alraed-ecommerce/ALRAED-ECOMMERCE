NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_WHATSAPP_NUMBER=0504848236
ADMIN_EMAILS=alraedsportsuae@gmail.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe test/live secret key and the signing secret for /api/checkout/webhook
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Order confirmation email via Resend (server-only)
RESEND_API_KEY=re_replace_me
EMAIL_FROM=Al Raed Sports <orders@your-verified-domain.example>

# Optional WhatsApp Cloud API order confirmations (server-only)
WHATSAPP_ACCESS_TOKEN=replace_with_meta_access_token
WHATSAPP_PHONE_NUMBER_ID=replace_with_meta_phone_number_id
WHATSAPP_TEMPLATE_NAME=order_confirmation
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_GRAPH_API_VERSION=v26.0

# Zoho Inventory stock sync (server-only; never use NEXT_PUBLIC_ for these)
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token
ZOHO_ORGANIZATION_ID=your_zoho_organization_id
ZOHO_LOCATION_IDS=location_id_1,location_id_2
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_URL=https://www.zohoapis.com
ZOHO_STOCK_MAX_AGE_SECONDS=900
ZOHO_LOW_STOCK_THRESHOLD=3
CRON_SECRET=replace_with_a_long_random_secret

# optional if you later add analytics
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id
